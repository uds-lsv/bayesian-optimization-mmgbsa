FROM mambaorg/micromamba:2.5.0-debian12

USER root

RUN apt-get update && apt-get install -y \
    wget git build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY docker/environment.rogi-xd.yml /tmp/environment.rogi-xd.yml

RUN micromamba install -y -n base -f /tmp/environment.rogi-xd.yml && \
    micromamba clean --all --yes

# autoencoders (ae_utils): rogi-xd submodule, referenced via SSH in setup.cfg.
# Install via HTTPS before rogi-xd so it is present when rogi-xd featurizers import it.
RUN /opt/conda/bin/pip install --no-cache-dir --no-deps --ignore-requires-python \
    git+https://github.com/davidegraff/autoencoders.git

# rogi-xd: clone without submodules (the autoencoders submodule uses SSH which fails
# in Docker), then install from the local checkout with --no-deps.
RUN git clone --depth 1 --no-recurse-submodules \
        https://github.com/coleygroup/rogi-xd.git /tmp/rogi-xd && \
    /opt/conda/bin/pip install --no-cache-dir --no-deps /tmp/rogi-xd && \
    rm -rf /tmp/rogi-xd

ARG USER_UID
ARG USER_NAME
ENV USER_GID=$USER_UID
ENV USER_GROUP="users"

RUN mkdir /home/$USER_NAME && \
    useradd -l -d /home/$USER_NAME -u $USER_UID -g $USER_GROUP $USER_NAME && \
    mkdir /home/$USER_NAME/.local && \
    chown -R ${USER_UID}:${USER_GID} /home/$USER_NAME/

ENV PATH="/opt/conda/bin:${PATH}"

CMD ["/bin/bash"]
